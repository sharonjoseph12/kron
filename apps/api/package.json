{
  "name": "@kron/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma db push --accept-data-loss",
    "prisma:deploy": "prisma db push --accept-data-loss",
    "prisma:seed": "tsx prisma/seed.ts",
    "bootstrap:chain": "tsx scripts/bootstrap-chain.ts",
    "bootstrap:contract": "tsx scripts/bootstrap-contract.ts",
    "demo:attack": "tsx scripts/demo-attack.ts",
    "demo:reset": "tsx scripts/reset-demo.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^10.0.0",
    "@kron/policy-engine": "workspace:*",
    "@kron/shared": "workspace:*",
    "@kron/x402": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prisma/client": "^6.19.3",
    "algosdk": "^3.6.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.0",
    "pino-pretty": "^13.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^24.0.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
