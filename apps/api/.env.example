# KRON API — environment configuration (copy to .env and adjust)
NODE_ENV=development

# --- Networking -------------------------------------------------
API_PORT=8787
DASHBOARD_PORT=5173
RESOURCE_PORT=9100
API_PUBLIC_URL=http://localhost:8787
DASHBOARD_URL=http://localhost:5173
RESOURCE_SERVER_URL=http://localhost:9100

# --- Database (SQLite for zero-Docker instant run) --------------
DATABASE_URL=file:./dev.db

# --- Algorand chain ---------------------------------------------
ALGORAND_NETWORK=testnet
ALGOD_URL=https://testnet-api.algonode.cloud
ALGOD_TOKEN=
INDEXER_URL=https://testnet-idx.algonode.cloud
INDEXER_TOKEN=

# Funding account used to top-up agent wallets (do not commit a real value).
FUNDING_MNEMONIC=

# KRON policy-anchor app ID. Auto-deployed on first payment when empty.
KRON_APP_ID=

# --- Security ---------------------------------------------------
# Auto-generated at boot when missing/too short. Set stable values for
# consistent sessions across restarts.
SESSION_SECRET=change-me-to-a-long-random-string
ENCRYPTION_KEY=change-me-to-a-32-byte-hex-key

# Seed operator credentials (used only when no user exists).
# Leave the password empty to have the seed print a random one.
SEED_ADMIN_EMAIL=operator@kron.local
SEED_ADMIN_PASSWORD=

# Optional: treat every payment as escalated (governance demo)
FORCE_ESCALATE=false

# PS 2.1 sandbox business DB (empty = <repo>/data/sandbox.db)
KRON_SANDBOX_DB=
KRON_RECORDING_MODE=false

# Optional: verbose Prisma query logging ("query" | "info" | "warn" | "error")
PRISMA_LOG=