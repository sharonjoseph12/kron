# KRON admin API (REST)
KRON_API_URL=http://localhost:8787
KRON_ADMIN_EMAIL=admin@kron.dev
KRON_ADMIN_PASSWORD=admin1234

# Agent identity + wallet
KRON_AGENT_NAME=market-research-02
KRON_FUND_AMOUNT_ALGO=2

# Demo resource server
KRON_RESOURCE_URL=http://localhost:9100
KRON_RESOURCE_SERVER_NAME=demo-resource
KRON_RESOURCE_TOOL=market/report

# LLM provider (gemini | anthropic | openai) - set the matching key to run the real agent loop
KRON_LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash-lite,gemini-3.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

KRON_MAX_ITERATIONS=10
