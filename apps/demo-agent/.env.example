# KRON admin API (REST)
KRON_API_URL=http://localhost:8787
KRON_ADMIN_EMAIL=admin@kron.dev
KRON_ADMIN_PASSWORD=admin1234

# Agent identity + wallet
KRON_AGENT_NAME=market-research-02
KRON_FUND_AMOUNT_ALGO=2

# Demo resource server (built by another agent)
KRON_RESOURCE_URL=http://localhost:9100
KRON_RESOURCE_SERVER_NAME=demo-resource
KRON_RESOURCE_TOOL=market/report

# LLM provider (anthropic | openai) — set a key to run the real agent loop
KRON_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
KRON_MAX_ITERATIONS=10
