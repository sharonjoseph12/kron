**/scripts/*.js
**/scripts/*.d.ts
**/scripts/*.map
**/prisma/*.js
**/prisma/*.d.ts
**/prisma/*.map
**/*.js.map
**/*.d.ts.map

# Tooling
.vercel/
.kilo/
.DS_Store
