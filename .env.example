# ============================================================
# KRON — Policy-Controlled Economic Runtime for AI Agents
# Environment configuration
# ============================================================

NODE_ENV=development

# --- Networking -------------------------------------------------
API_PORT=8787
DASHBOARD_PORT=5173
RESOURCE_PORT=9100
# Publicly reachable base URLs (agents/dashboard reach the API)
API_PUBLIC_URL=http://localhost:8787
DASHBOARD_URL=http://localhost:5173
RESOURCE_SERVER_URL=http://localhost:9100

# --- Database (KRON app) ---------------------------------------
# Default: SQLite via the API package — zero-Docker instant run
# (apps/api/.env uses DATABASE_URL=file:./dev.db).
# For shared Postgres (docker-compose), use:
#   postgresql://kron:kron@localhost:5433/kron
DATABASE_URL=file:./dev.db

# --- Algorand chain ---------------------------------------------
# localnet  -> the private dev-mode node from docker-compose
# testnet   -> public testnet (AlgoNode free endpoints, no token needed)
# mainnet   -> production (not for hackathon)
ALGORAND_NETWORK=testnet
# For localnet: http://localhost:4001 with the dev token
# For testnet:  AlgoNode public endpoints (no token required)
ALGOD_URL=https://testnet-api.algonode.cloud
ALGOD_TOKEN=
INDEXER_URL=https://testnet-idx.algonode.cloud
INDEXER_TOKEN=

# Funding account used to top-up agent wallets on localnet.
# Populated automatically by `pnpm bootstrap` (do not commit real value).
FUNDING_MNEMONIC=

# KRON policy-anchor contract app ID. Auto-deployed on first payment when
# empty/FUNDING_MNEMONIC is set; set explicitly to skip the deploy step.
KRON_APP_ID=

# --- Security ---------------------------------------------------
# Auto-generated at boot when missing/too short (see apps/api/src/config.ts).
# Set stable values explicitly for consistent sessions across restarts.
SESSION_SECRET=change-me-to-a-long-random-string
# 32-byte hex AES-256 key used to encrypt wallet mnemonics at rest
ENCRYPTION_KEY=change-me-to-a-32-byte-hex-key

# Seed admin credentials (used only when no users exist)
SEED_ADMIN_EMAIL=admin@kron.dev
SEED_ADMIN_PASSWORD=admin1234

# --- x402 / MCP demo --------------------------------------------
# Optional: treat every payment as escalated (good for a governance demo)
FORCE_ESCALATE=false

# --- Resource server --------------------------------------------
# Publicly reachable base URL for x402 instruction/payment links
KRON_BASE_URL=http://localhost:9100
# Path to a custom resources.json (see apps/resource-server/src/resources.ts)
KRON_RESOURCES_FILE=

# --- Dashboard --------------------------------------------------
# When unset, Vite dev proxy forwards /api and /mcp to the KRON API.
VITE_KRON_API_URL=http://localhost:8787
# Displayed network label ("testnet" | "localnet" | "mainnet")
VITE_ALGORAND_NETWORK=testnet
